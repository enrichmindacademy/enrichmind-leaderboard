# Client-side (safe to expose — Supabase anon key is designed for browser use)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# No passcode env var anymore — the teacher signs in with a real Supabase
# Auth account instead (create it once in Supabase: Authentication > Users
# > Add user). See the README's "Teacher login" section.

# Server-side only (Netlify Functions). Set these in Netlify's dashboard
# under Site settings > Environment variables — NEVER prefix them with
# VITE_ or they'll be bundled into the public client build.
ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# (the parent-portal and get-parent-link functions reuse VITE_SUPABASE_URL
# above for the project URL — that part isn't secret, only the service
# role key is. Find it in Supabase: Project Settings > API > service_role.)
